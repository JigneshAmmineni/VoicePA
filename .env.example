# Copy to .env and fill in. Never commit the real .env.

# Deepgram — speech to text (used only after the wake word fires, or on TALK)
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Cartesia — text to speech
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# CARTESIA_MODEL=sonic-3
# CARTESIA_SPEED=0.90    # 0.6–1.5; 1.0 = the voice's native pace
# CARTESIA_VOLUME=1.0    # 0.5–2.0
# CARTESIA_EMOTION=sarcastic   # default sarcastic; empty = the model reads the transcript's subtext.
#                              # Full list: https://docs.cartesia.ai/api-reference/tts/bytes (generation_config)
#                              # Primaries: neutral calm angry content sad scared.

# Hands-free endpointing (ALWAYS ON): after the wake word, recording stops once this much
# silence follows your speech, or at the cap regardless. Loudness threshold is RMS 0..1.
# WAKE_SILENCE_MS=3000
# WAKE_MAX_MS=15000
# WAKE_SPEECH_RMS=0.02

# Follow-up window: after a spoken reply the mic stays open this long, so the next sentence
# needs no wake word or hotkey. Every spoken turn earns a new window; silence ends it. 0 = off.
# FOLLOWUP_MS=12000

# Wake word — openWakeWord runs on the server, no account or key needed.
# Default is the community "computer" model (also fires on "hey computer" / "ok computer").
# Alternatives in models/wake: computer_v2.onnx, ok_computer.onnx. Or a bundled name:
# hey_jarvis, alexa, hey_mycroft. Relative paths resolve from the project root.
# WAKE_MODEL=models/wake/computer_v1.onnx
# WAKE_THRESHOLD=0.5

# Global hotkey — one press starts a voice turn (it ends on silence, like the wake word),
# a second press ends it early, a press while the assistant speaks or thinks interrupts.
# Works from any window; the dashboard tab just has to be open. The key still reaches
# the focused app. pynput syntax: <f8>, <ctrl>+<alt>+<space>, or a single key such as
# <ctrl_r> (right Ctrl: no Fn on laptops, no side effect, as long as you don't use that
# Ctrl for shortcuts). Empty = off.
# HOTKEY=<f8>

# Claude — leave empty to use the Claude Code sign-in on this machine (your own
# subscription). Set a key to bill the API per token instead. A key inherited from the
# shell is ignored on purpose; only one written here counts.
# ANTHROPIC_API_KEY=

# Agent — which Claude model the session runs on (switchable live via POST /api/model)
# AGENT_MODEL=claude-sonnet-5-5

# Dashboard
DASH_PORT=7789
